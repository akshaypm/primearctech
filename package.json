{
  "name": "fieldrelay-premium-homepage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build --precompress",
    "start": "vinext start",
    "test": "npm run test:unit && npm run test:rendered",
    "test:unit": "vitest run",
    "test:rendered": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "vapi:sync": "node scripts/sync-vapi-assistant.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vapi-ai/web": "^2.6.1",
    "drizzle-orm": "0.45.2",
    "motion": "^13.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.171.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "lighthouse": "^13.4.1",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "sharp-cli": "^5.2.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
